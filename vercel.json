{
  "functions": {
    "api/index.ts": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "X-StartHustler-Cache-Refresh",
          "value": "2026-10-08"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/kelas/solopreneur-class",
      "destination": "/kelas/kelas-solopreneur",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__cms_path=api/:path*"
    },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
